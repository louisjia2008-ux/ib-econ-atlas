{
  "name": "ib-econ-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An independent bilingual IB Economics study atlas for the 2022-2029 syllabus.",
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/compile-content.mjs --allow-incomplete",
    "dev": "vite",
    "build": "node scripts/compile-content.mjs && tsc -b && vite build",
    "build:preview": "node scripts/compile-content.mjs --allow-incomplete && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false && tsc -p worker/tsconfig.json --pretty false",
    "content:validate": "node scripts/validate-content.mjs",
    "content:validate:draft": "node scripts/validate-content.mjs --allow-incomplete",
    "content:report": "node scripts/generate-content-report.mjs",
    "content:report:check": "node scripts/generate-content-report.mjs --check",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest",
    "test:run": "vitest run",
    "test:worker": "vitest run worker",
    "test:pwa": "node scripts/verify-pwa.mjs",
    "test:secrets": "node scripts/scan-secrets.mjs",
    "test:repository": "node scripts/validate-repository.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run content:validate && npm run content:report:check && npm run test:repository && npm run lint && npm run typecheck && npm run test:run && npm run build && npm run test:pwa && npm run test:secrets"
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.48.0",
    "openai": "^7.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "ts-fsrs": "^5.4.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
